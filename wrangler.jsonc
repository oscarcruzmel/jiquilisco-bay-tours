{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jiquilisco-bay-tours",
  "main": "worker.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  }
}
